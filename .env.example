# =============================================================================
# Mining Stack Production Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to git (it contains secrets)

# -----------------------------------------------------------------------------
# Docker Registry Configuration
# -----------------------------------------------------------------------------
GITHUB_REPOSITORY=dvkorolev/mining-stack
IMAGE_TAG=latest

# Optional: GitHub Authentication (for private packages)
# GITHUB_USERNAME=your_username
# GITHUB_TOKEN=your_personal_access_token

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Comma-separated allowlist of browser origins permitted to send credentialed (cookie) requests.
# Example: CORS_ORIGIN=http://localhost:3000,http://192.168.1.66:3000
# Unset or "*" -> dev reflects origin with credentials; production disables credentialed CORS.
CORS_ORIGIN=*

# ALLOW_LEGACY_HEADER_AUTH=false  # insecure X-Telegram-Chat-ID admin fallback; keep false unless required

# JWT secrets — REQUIRED in production; generate with: openssl rand -hex 32
# JWT_ACCESS_SECRET=replace_with_a_secure_random_secret
# JWT_REFRESH_SECRET=replace_with_a_secure_random_secret

# Paths
DATA_DIR=/app/data
LOGS_DIR=/app/logs
MINER_CONFIG_PATH=/opt/mining-stack/etc/miners.yaml

# Mining Stats
MINING_UPDATE_INTERVAL=30000
MINING_MAX_HISTORY=60
USE_REAL_DATA=true
# Set to true ONLY to serve SIMULATED (fake) mining data for demos/testing.
# Default false: the backend serves real metrics from Prometheus and never falls back to fake data.
SIMULATION_MODE=false
# Source of truth for live miner stats: 'prometheus' (default; backend reads Prometheus on an interval)
# or 'push' (python-scheduler POSTs to /api/internal/metrics and is authoritative).
# In 'prometheus' mode the push endpoint still returns 200 but does NOT overwrite live stats.
METRICS_SOURCE=prometheus

# Prometheus Integration
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_ENABLED=true

# Job Runner Service
JOB_RUNNER_URL=http://python-scheduler:8000

# -----------------------------------------------------------------------------
# Python Scheduler Configuration
# -----------------------------------------------------------------------------
METRICS_DIR=/metrics
MINERS_CONFIG=/app/etc/miners.yaml
POOLS_CONFIG=/app/etc/pools.yaml
COLLECTION_INTERVAL=2
# Miners polled in parallel per collection cycle.
MAX_CONCURRENT_REQUESTS=5
BACKEND_URL=http://backend:5000
PUSH_TO_BACKEND=true
# INTERNAL_METRICS_TOKEN=set_shared_secret_for_scheduler_metrics_push  # optional in dev, required in production

# Logging Configuration
LOG_FORMAT=json
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Alert Thresholds (Global Defaults)
# -----------------------------------------------------------------------------
# Temperature thresholds (Celsius)
# WARNING: Your miners are running 88-105°C! This is dangerous!
# Adjust these thresholds based on your cooling situation:
THRESHOLD_TEMP_WARNING=85   # Yellow warning
THRESHOLD_TEMP_CRITICAL=95  # Red critical (hardware damage risk)
THRESHOLD_TEMP_SHUTDOWN=105 # Emergency shutdown needed

# Hashrate thresholds (percent below expected)
THRESHOLD_HASHRATE_WARNING_PCT=20
THRESHOLD_HASHRATE_CRITICAL_PCT=50

# Power thresholds (percent deviation)
THRESHOLD_POWER_WARNING_PCT=15

# Rejection rate thresholds (percent)
THRESHOLD_REJECTION_WARNING=2.0
THRESHOLD_REJECTION_CRITICAL=5.0

# Fan speed thresholds (RPM)
THRESHOLD_FAN_WARNING=3000
THRESHOLD_FAN_CRITICAL=2000

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------
# REQUIRED: Grafana admin password. docker-compose.prod.yml fails to start if this is unset. Set a strong value.
GF_SECURITY_ADMIN_PASSWORD=
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROOT_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Telegram Bot Configuration (Optional)
# -----------------------------------------------------------------------------
# Configure via Web UI at http://localhost:3000/settings
# Or set environment variables directly:

# Bot Token from @BotFather
# --- Alert notification channel ---------------------------------------------
# Where a firing alert is sent. Delivery is always reported, never assumed:
# every attempt is counted in alert_notifications_total{channel,outcome}.
#   telegram - send via the Telegram bot (default)
#   ntfy     - push to an ntfy topic. The only channel that can confirm delivery,
#              so the only one that ever reports `delivered`.
#   log      - stub: record the alert at WARN and count it as not_delivered.
#              Use where Telegram is unreachable, so alerts stay visible in the
#              logs instead of vanishing into a channel that cannot deliver.
#   none     - deliberately silent, still counted.
# ALERT_NOTIFY_CHANNEL=telegram

# Components that must never raise a notification, comma-separated and
# case-insensitive. The alert is still recorded, still shown in the dashboard and
# still logged -- this only decides whether it reaches a phone. A suppressed
# alert is counted as not_delivered with a stated reason, never silently dropped.
# Empty by default: an unset value notifies about everything, so the failure
# direction is one notification too many rather than one silently withheld.
# Rule components in use: miner, farm, uplink, scheduler, system, pool, network,
# logging. Excluding `miner` stops per-machine chronic conditions (overheating,
# error codes, long-dead hardware) from burying the farm-wide events that matter.
# ALERT_NOTIFY_EXCLUDE_COMPONENTS=miner

# Individual rules that must never notify, comma-separated and case-insensitive.
# The scalpel to the component denylist's blunt instrument: for a rule whose
# component is otherwise worth waking up for, but whose condition is accepted.
# Example: FarmMultipleMinersOffline is component=farm and permanently true on a
# site with decommissioned machines still in the inventory -- left in, it pushes
# every repeat_interval forever and teaches you to ignore the farm category that
# also carries a real fleet outage. Prefer fixing the condition where you can.
# ALERT_NOTIFY_EXCLUDE_ALERTS=FarmMultipleMinersOffline

# --- ntfy (used only when ALERT_NOTIFY_CHANNEL=ntfy) -------------------------
# Topic to publish to. REQUIRED for the channel: selected-but-unset reports
# not_delivered with a stated reason rather than silently sending nothing.
# Anyone who knows a public topic name can read it, so pick an unguessable one.
# NTFY_TOPIC=mining-stack-7f3a91c2e5
#
# Server. Defaults to the public https://ntfy.sh; point it at a self-hosted
# instance if you would rather not publish alerts to a third party.
# NTFY_URL=https://ntfy.sh

# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Comma-separated list of authorized Telegram Chat IDs
# Get your Chat ID by sending /whoami to your bot
# TELEGRAM_CHAT_ID=123456789,987654321

# Admin Telegram Chat ID (for ownership transfer and admin features)
# This should be ONE admin user's Chat ID
# ADMIN_TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Multi-User Database Configuration
# -----------------------------------------------------------------------------
# System API Key for internal service authentication (python-scheduler -> backend)
# Generate a secure random key: openssl rand -hex 32
# SYSTEM_API_KEY=your_secure_random_key_here

# Database Configuration Mode
# Set to 'true' to use database instead of YAML for miner configuration
# Set to 'false' to fallback to YAML (for migration period)
# USE_DATABASE_CONFIG=true

# -----------------------------------------------------------------------------
# Router exporter (DMI-47) — uplink health and traffic accounting
# -----------------------------------------------------------------------------
# The Keenetic exposes its CLI as JSON over HTTP (RCI). Authentication is a
# challenge scheme of its own, not Basic or Digest. The exporter refuses to start
# without a password rather than reporting router_up 0 forever.
ROUTER_HOST=192.168.2.1
ROUTER_USER=admin
# ROUTER_PASSWORD=your_router_admin_password

# Byte counters come from the router's IF-MIB, because RCI exposes none.
# Community is read-only and LAN-only; the default on this device is 'public'.
ROUTER_SNMP_COMMUNITY=public

# The active WAN interface. This site is 4G-only: GigabitEthernet1 is permanently
# down by design, and the uplink is the USB modem on CdcEthernet2.
ROUTER_UPLINK_INTERFACE=CdcEthernet2

# -----------------------------------------------------------------------------
# WAN watchdog (DMI-49) — restarts the router when the uplink stays down
# -----------------------------------------------------------------------------
# Ships DISARMED. While false the watchdog only logs what it would have done.
# Arming it means a production router gets rebooted automatically after 10
# minutes of confirmed downtime, so it is a deliberate decision, not a default.
# Requires ROUTER_PASSWORD above; it refuses to start armed without one.
WAN_WATCHDOG_ARM=false
